# Copy this file to .env.local and fill in your own values.
# Never expose the API key through NEXT_PUBLIC_* variables or browser code.

# Server-side OpenAI key only.
OPENAI_API_KEY=

# Server-side kill switch. Keep false until you intentionally run a real generation.
ENABLE_IMAGE_API=false

# Local material workflow always uses filesystem storage.
NEXT_PUBLIC_IMAGE_STORAGE_MODE=fs

# Optional password gate. Leave empty to disable.
# APP_PASSWORD=

# Optional server-side output directory. Relative paths resolve from the repo root.
# Default: generated-images
# IMAGE_OUTPUT_DIR=generated-images

# Optional Node 24 outbound proxy. scripts/start-local.mjs reads these and injects
# them into the Next.js process before it starts. Do not put a proxy URL into a
# custom OpenAI base URL. Use the real local proxy address, not a guessed port.
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1,192.168.*,10.*,*.local

# Creative workbench (optional). See docs/WORKBENCH.zh-CN.md.
# WORKBENCH_DATA_DIR=.workbench-data
# WORKBENCH_PLANNER_MODEL=gpt-6.1-sol
# WORKBENCH_PLANNER_MODELS=gpt-6.1-sol,gpt-6-astra
# WORKBENCH_PLANNER_REASONING_EFFORT=medium
# WORKBENCH_ANALYSIS_MODEL=gpt-6.1-sol
# WORKBENCH_REVIEW_MODEL=gpt-6.1-sol
# WORKBENCH_SEARCH_MODEL=gpt-6.1-sol
# WORKBENCH_IMAGE_MODEL=gpt-image-2.6-sunburst
# WORKBENCH_WORKER_TOKEN=generated-by-start-local
# WORKBENCH_STALE_SENDING_MINUTES=20
