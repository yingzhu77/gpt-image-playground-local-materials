# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-ui-*/
/.next-removal-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated images, metadata and local verification artifacts
generated-images/
/test-artifacts/
/.local-server*
/.workbench-data/

# Third-party local UI theme images: kept on this machine, never project MIT assets.
/public/local-theme/*.jpg
/public/local-theme/*.jpeg
/public/local-theme/*.png
/public/local-theme/*.webp
